# Minimal settings matching the existing code style. Do not reformat existing files:
# trailing whitespace and final newlines are intentionally not enforced, and the two Java files
# indented with 4 spaces (DefaultCorrelationIdGenerator, IOCorrelationIdGenerator) keep their style.
root = true

[*]
charset = utf-8
end_of_line = lf

[*.{java,xml}]
indent_style = tab
tab_width = 4

[*.cmd]
end_of_line = crlf
